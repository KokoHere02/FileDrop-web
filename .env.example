# 开发环境默认由 Vite 将 /api 代理到 localhost:8080
VITE_API_BASE_URL=/api
# 留空时按当前页面协议自动使用 ws/wss，并连接 /api/ws
VITE_SIGNALING_URL=
VITE_STUN_URL=stun:stun.l.google.com:19302
# 可选：覆盖 STUN 配置，支持部署提供的 STUN/TURN 列表（JSON 数组）
# 浏览器可读取构建变量，请仅使用可公开的配置或短期 TURN 凭证。
# VITE_ICE_SERVERS=[{"urls":"stun:stun.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"temporary-user","credential":"temporary-password"}]
